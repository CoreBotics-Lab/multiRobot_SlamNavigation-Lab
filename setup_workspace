            rm -f pixi.lock
            pixi install
        else
            exit 1
        fi
    fi
}

if [[ "$CURRENT_DISTRO" == "$TARGET_DISTRO" ]]; then
    if [[ -d ".pixi" ]]; then
        target_py="$(get_recommended_python "$TARGET_DISTRO")"
        installed_py=""
        if [[ -x ".pixi/envs/default/bin/python" ]]; then
            installed_py="$(".pixi/envs/default/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
        fi
        if [[ "$target_py" != "*" && -n "$installed_py" && "${installed_py}.*" != "$target_py" ]]; then
            ensure_pixi
            echo "Updating '$TARGET_DISTRO' Python from $installed_py to $target_py (recommended by docs.ros.org)..."
            rm -f pixi.lock
            install_with_recommended_python "$TARGET_DISTRO"
        fi
        sync_python_version
        echo "ROS 2 distro is already '$TARGET_DISTRO' and installed. Skipping."
        exit 0
    else
        ensure_pixi
        echo "ROS 2 distro is already '$TARGET_DISTRO', but '.pixi/' is missing. Running 'pixi install'..."
        install_with_recommended_python "$TARGET_DISTRO"
        sync_python_version
        exit 0
    fi
fi

check_robostack_channel() {
    local distro="$1"
    if command -v curl >/dev/null 2>&1; then
        local url="https://prefix.dev/robostack-${distro}/linux-64/repodata.json"
        local code
        code="$(curl -s -o /dev/null -w "%{http_code}" --max-time 6 "$url" || true)"
        if [[ "$code" == "404" ]]; then
            echo "Error: RoboStack channel 'https://prefix.dev/robostack-${distro}' does not exist (HTTP 404)." >&2
            echo "Your workspace files and current environment were not modified." >&2
            exit 1
        fi
    fi
}

ensure_pixi

check_robostack_channel "$TARGET_DISTRO"

echo "Switching ROS 2 distro from '$CURRENT_DISTRO' to '$TARGET_DISTRO'..."

sed -i \
    -e "s/robostack-${CURRENT_DISTRO}/robostack-${TARGET_DISTRO}/g" \
    -e "s/ros-${CURRENT_DISTRO}-/ros-${TARGET_DISTRO}-/g" \
    pixi.toml

if [[ -f ".vscode/settings.json" ]]; then
    sed -i \
        "s/\"ros\.distro\": \"${CURRENT_DISTRO}\"/\"ros.distro\": \"${TARGET_DISTRO}\"/g" \
        .vscode/settings.json
fi

rm -f pixi.lock
rm -rf build/ install/ log/ .pixi/

install_with_recommended_python "$TARGET_DISTRO"
sync_python_version

echo "Successfully switched ROS 2 distro to '$TARGET_DISTRO'."

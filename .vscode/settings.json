{
    // --- Python & Pyrefly ---
    "python.languageServer": "Default",
    "python.pyrefly.typeCheckingMode": "default",
    "python.pyrefly.disableTypeErrors": false,
    "python.REPL.enableREPLSmartSend": false,
    // --- C++ & Clangd ---
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--header-insertion=never",
        "--all-scopes-completion",
        "--completion-style=detailed"
    ],
    // --- ROS 2 Specifics ---
    "ROS2.distro": "lyrical",
    "cmake.ignoreCMakeListsMissing": true,
    // --- Performance & UI ---
    "git.autofetch": false,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true,
        "**/__pycache__/**": true
    },
    "files.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true
    },
    "python.autoComplete.extraPaths": [
        "/root/ros2_ws/install/topics/lib/python3.14/site-packages",
        "/root/ros2_ws/install/ros2_interfaces/lib/python3.14/site-packages",
        "/opt/ros/lyrical/opt/gz_sim_vendor/lib/python",
        "/opt/ros/lyrical/opt/gz_transport_vendor/lib/python",
        "/opt/ros/lyrical/opt/sdformat_vendor/lib/python",
        "/opt/ros/lyrical/opt/gz_msgs_vendor/lib/python",
        "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
 
    // urdf-visualizer extention settings
    "urdf-visualizer.packages": {
        "gizmo_description": "/root/ros2_ws/src/gizmo/gizmo_description"
    },
    "python.analysis.extraPaths": [
        "/opt/ros/lyrical/opt/gz_sim_vendor/lib/python",
        "/opt/ros/lyrical/opt/gz_transport_vendor/lib/python",
        "/opt/ros/lyrical/opt/sdformat_vendor/lib/python",
        "/opt/ros/lyrical/opt/gz_msgs_vendor/lib/python",
        "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
    "python-envs.defaultEnvManager": "ms-python.python:system"
    // urdf-visualizer extention settings

}
<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="wheel_left_set_m" value="0.0258312" />
    <xacro:property name="wheel_left_set_o_xyz" value="0 -0.0025 0" />
    <xacro:property name="wheel_left_set_o_rpy" value="${pi/2} 0 0" />
    xacro:<xacro:property name="wheel_left_set_h" value="0.0130" />

    <xacro:property name="wheel_left_d" value="0.070" />
    <xacro:property name="wheel_left_r" value="${wheel_left_d / 2}" />
    <xacro:property name="wheel_left_o_xyz" value="0 0 0" />
    <xacro:property name="wheel_left_o_rpy" value="0 0 0" />

  <!-- Link wheel_left -->
  <link name="wheel_left">
  
    <xacro:cylinder_inertia m="${wheel_left_set_m}" r="${wheel_left_r}" h="${wheel_left_set_h}" o_xyz="${wheel_left_set_o_xyz}" o_rpy="${wheel_left_set_o_rpy}"/>

    <collision>
      <origin xyz="${wheel_left_o_xyz}" rpy="${wheel_left_o_rpy}"/>
      <geometry>
        <sphere radius="${wheel_left_r}"/>
      </geometry>
    </collision>

    <!-- Part rim -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gizmo_description/meshes/rim.stl"/>
      </geometry>
      <material name="rim_material">
        <color rgba="0.0941176 0.580392 0.545098 1"/>
      </material>
    </visual>

    <!-- Part tire -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gizmo_description/meshes/tire.stl"/>
      </geometry>
      <material name="tire_material">
        <color rgba="0.0784314 0.0784314 0.0784314 1"/>
      </material>
    </visual>

    <!-- Part 25t_servo_horn_l -->
    <visual>
      <origin xyz="0 -0.00699 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gizmo_description/meshes/25t_servo_horn_l.stl"/>
      </geometry>
      <material name="25t_servo_horn_l_material">
        <color rgba="0.960784 0.960784 0.964706 1"/>
      </material>
    </visual>

    <!-- Part servo_horn_adapter_wheel70mm__l -->
    <visual>
      <origin xyz="0 -0.0045 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gizmo_description/meshes/servo_horn_adapter_wheel70mm__l.stl"/>
      </geometry>
      <material name="servo_horn_adapter_wheel70mm__l_material">
        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>

    <!-- Part bn_1593_1348663_hexagon_socket_button_head_screw_m3x6_15 -->
    <visual>
      <origin xyz="-0.00824889 0.0015 -0.0047625" rpy="${pi/2} 0 -${pi/2}"/>
      <geometry>
        <mesh filename="package://gizmo_description/meshes/bn_1593_1348663_hexagon_socket_button_head_screw_m3x6.stl"/>
      </geometry>
      <material name="bn_1593_1348663_hexagon_socket_button_head_screw_m3x6_15_material">
        <color rgba="0.941176 0.941176 0.941176 1"/>
      </material>
    </visual>


    <!-- Part bn_1593_1348663_hexagon_socket_button_head_screw_m3x6_16 -->
    <visual>
      <origin xyz="0 0.0015 0.009525" rpy="${pi/2} 0 -${pi/2}"/>
      <geometry>
        <mesh filename="package://gizmo_description/meshes/bn_1593_1348663_hexagon_socket_button_head_screw_m3x6.stl"/>
      </geometry>
      <material name="bn_1593_1348663_hexagon_socket_button_head_screw_m3x6_16_material">
        <color rgba="0.941176 0.941176 0.941176 1"/>
      </material>
    </visual>

    <!-- Part bn_1593_1348663_hexagon_socket_button_head_screw_m3x6_17 -->
    <visual>
      <origin xyz="0.00824889 0.0015 -0.0047625" rpy="${pi/2} 0 -${pi/2}"/>
      <geometry>
        <mesh filename="package://gizmo_description/meshes/bn_1593_1348663_hexagon_socket_button_head_screw_m3x6.stl"/>
      </geometry>
      <material name="bn_1593_1348663_hexagon_socket_button_head_screw_m3x6_17_material">
        <color rgba="0.941176 0.941176 0.941176 1"/>
      </material>
    </visual>

    <!-- Part bn_1593_1348663_hexagon_socket_button_head_screw_m3x6_18 -->
    <visual>
      <origin xyz="0 0.0015 0" rpy="${pi} 0 -${pi/2}"/>
      <geometry>
        <mesh filename="package://gizmo_description/meshes/bn_1593_1348663_hexagon_socket_button_head_screw_m3x6.stl"/>
      </geometry>
      <material name="bn_1593_1348663_hexagon_socket_button_head_screw_m3x6_18_material">
        <color rgba="0.941176 0.941176 0.941176 1"/>
      </material>
    </visual>

  </link>

</robot>
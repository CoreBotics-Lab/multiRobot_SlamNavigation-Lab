<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="wheel_separation" value="0.13827727" />
    <xacro:property name="wheel_radius" value="0.035" />

    <!-- Left Wheel Surface Friction & Contact Stability -->
    <gazebo reference="wheel_left">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <!-- Right Wheel Surface Friction & Contact Stability -->
    <gazebo reference="wheel_right">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <!-- Caster Wheel Surface Friction & Contact Stability (Sliding) -->
    <gazebo reference="caster_wheel">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>1.0</maxVel>
    </gazebo>

    <!-- Gazebo Differential Drive Plugin -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <!-- Wheel Joints -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <!-- Kinematics & Dimensions -->
            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>

            <!-- Limits & Acceleration (Smoothed for smooth braking without wheelie jerk) -->
            <max_linear_velocity>0.73</max_linear_velocity>
            <min_linear_velocity>-0.73</min_linear_velocity>
            <max_angular_velocity>3.14</max_angular_velocity>
            <min_angular_velocity>-3.14</min_angular_velocity>
            <max_linear_acceleration>2.5</max_linear_acceleration>
            <min_linear_acceleration>-2.5</min_linear_acceleration>
            <max_angular_acceleration>5.0</max_angular_acceleration>
            <min_angular_acceleration>-5.0</min_angular_acceleration>
            <max_torque>5.0</max_torque>

            <!-- Topics & Frames -->
            <topic>/cmd_vel</topic>
            <odom_topic>/wheel_odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>

            <!-- Publishing Options -->
            <publish_odom>true</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
        </plugin>

        <!-- Joint State Publisher Plugin for Gazebo -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

</robot>

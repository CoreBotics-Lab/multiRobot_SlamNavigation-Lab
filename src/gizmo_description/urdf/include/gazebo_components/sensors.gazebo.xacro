<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- sensor system plugin for gazebo -->
    <gazebo>
        <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <!-- Sensor toggles -->
    <xacro:arg name="use_lidar" default="true"/>
    <xacro:arg name="use_camera" default="true"/>
    <xacro:arg name="use_imu" default="true"/>

    <!-- lidar plugin -->
    <xacro:if value="${'$(arg use_lidar)' in ['true', 'True', '1']}">
        <xacro:include filename="$(find gizmo_description)/urdf/include/gazebo_components/lidar.gazebo.xacro" />
    </xacro:if>

    <!-- camera plugin -->
    <xacro:if value="${'$(arg use_camera)' in ['true', 'True', '1']}">
        <xacro:include filename="$(find gizmo_description)/urdf/include/gazebo_components/camera.gazebo.xacro" />
    </xacro:if>
    
    <!-- imu plugin -->
    <xacro:if value="${'$(arg use_imu)' in ['true', 'True', '1']}">
        <xacro:include filename="$(find gizmo_description)/urdf/include/gazebo_components/imu.gazebo.xacro" />
    </xacro:if>

</robot>
<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gizmo_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo simulation worlds, launch files, EKF sensor fusion, and bridge configurations for Gizmo robots.</description>
  <maintainer email="hayisyed@gmail.com">CoreBotics-Lab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>robot_localization</depend>
  <depend>gizmo_description</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
